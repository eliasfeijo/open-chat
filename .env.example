# Local PostgreSQL defaults match docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/open_chat"

# Better Auth local development settings.
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Realtime local development settings.
REALTIME_GATEWAY_PORT="3001"
NEXT_PUBLIC_REALTIME_WS_URL="ws://localhost:3001/ws"

# Redis is not consumed by the current auth/users foundation yet.
# Keep placeholder Upstash REST values until the repository introduces
# a local Redis adapter or a runtime path that actually requires Redis.
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"